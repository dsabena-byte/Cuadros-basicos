# Secret compartido con Power Automate. El flow tiene que mandarlo en el
# header `x-refresh-secret` cuando llama POST /api/ventas o /api/refresh.
# El nombre lleva "1" al final porque REFRESH_SECRET ya estaba ocupado en
# este proyecto Vercel por otro flow que no hay que tocar.
REFRESH_SECRET1=

# Token de Vercel Blob — lo crea Vercel automáticamente cuando conectás un
# Blob store al proyecto (Settings → Storage → Create → Blob). En local no
# hace falta: si no está, `writeVentas` escribe a /public/data/ventas.json.
BLOB_READ_WRITE_TOKEN=
