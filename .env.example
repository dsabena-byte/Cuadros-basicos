# JSON entero de la service account de Google Cloud (lectura sobre Drive).
# Pegá el contenido del archivo .json de credenciales en una sola linea.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID de la carpeta de Drive donde se suben los CSV semanales.
DRIVE_FOLDER_ID=1J7NORR3iwnjbKrIAbjB79N7h5klGFYR3

# Secreto compartido con Apps Script para el webhook /api/refresh.
REFRESH_SECRET=

# Tiempo de cache del dashboard en segundos (ISR fallback).
DASHBOARD_REVALIDATE_SECONDS=3600

# ====== Fuente de datos del dashboard CB / Floor Share ======

# Fuente de datos: "drive" (default, lee CSVs en cada request) o "supabase"
# (lee de la base sincronizada por Apps Script). Para cutover gradual:
# 1) deployar con DATA_SOURCE=drive (comportamiento histórico)
# 2) probar preview con DATA_SOURCE=supabase
# 3) cambiar prod a supabase cuando esté validado
DATA_SOURCE=drive

# URL del proyecto Supabase (https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# Anon key de Supabase. Solo lectura sobre las tablas del dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ====== /ventas dashboard (Power Automate → Vercel Blob) ======

# Secret compartido con Power Automate. El flow lo manda en el header
# `x-refresh-secret` cuando llama POST /api/ventas.
# Lleva "1" al final porque REFRESH_SECRET ya está ocupado por el flow
# de Apps Script del dashboard CB/FloorShare.
REFRESH_SECRET1=

# Token de Vercel Blob — lo crea Vercel automáticamente cuando conectás un
# Blob store al proyecto (Settings → Storage → Create → Blob).
# En local no hace falta: si no está, writeVentas escribe a /data/ventas.json.
BLOB_READ_WRITE_TOKEN=

# ====== Copiloto de datos ("Preguntá a tus datos") ======

# API key de OpenAI. Sin esta variable el botón sigue apareciendo pero
# /api/chat responde 500. Es la MISMA variable que usa el dashboard de
# Marketing, así que podés reusar la key (son proyectos separados en Vercel,
# hay que cargarla en los dos).
OPENAI_API_KEY=

# Modelo a usar. Default: gpt-4o-mini.
OPENAI_CHAT_MODEL=gpt-4o-mini

# JWT usado para firmar la sesión de /ventas. El copiloto de Sell-in exige
# esa misma sesión antes de responder.
JWT_SECRET=
